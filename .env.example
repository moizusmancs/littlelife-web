# Copy to .env.local for local overrides (gitignored).

# Base URL the Go backend is reachable at. The backend allows CORS from the dev origin
# directly, so no Vite proxy is needed — point this straight at the real API.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Set to "true" to start the MSW worker for not-yet-built backend domains (Phase 7).
# VITE_ENABLE_MOCKS=true

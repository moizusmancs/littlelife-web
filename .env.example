# Copy to .env.local for local overrides (gitignored).

# Base URL the Go backend is reachable at. Leave unset in local dev if you're proxying
# /api/v1 through Vite; set to the real API origin otherwise.
# VITE_API_BASE_URL=http://localhost:8080/api/v1

# Set to "true" to start the MSW worker for not-yet-built backend domains (Phase 7).
# VITE_ENABLE_MOCKS=true
